# Database Configuration
# PostgreSQL connection string format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/lead_generator

# Telegram Notifications (Optional)
# Get bot token from @BotFather on Telegram
# Get chat ID from @userinfobot or your channel/group
# Multiple chat IDs: Use comma-separated values to send to multiple chats
# Example: TELEGRAM_CHAT_ID=123456789,-1001234567890
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_personal_chat_id,your_group_chat_id

# Optional: Python unbuffered mode for Docker logs
PYTHONUNBUFFERED=1
