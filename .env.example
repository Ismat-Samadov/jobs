# Complete Environment Variables Template (.env)

# General Django Settings
SECRET_KEY=your-django-secret-key-here-generate-new-one
DEBUG=False
DJANGO_SETTINGS_MODULE=your_project.settings

# PostgreSQL Database Settings (Neon)
PGHOST=your-database-host.neon.tech
PGDATABASE=your_database_name
PGUSER=your_database_user
PGPASSWORD=your_secure_database_password

# Alternative Database Settings (for compatibility)
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_database_password
DB_HOST=your-database-host.neon.tech
DB_PORT=5432

# Web Scraper/Authentication Settings
EMAIL=your-email@example.com
PASSWORD=your_secure_password

# API Keys and Tokens
ACCESS_TOKEN=your-access-token-here
OPENAI_API_KEY=sk-your-openai-api-key-here

# DigitalOcean Spaces (S3-compatible) Settings
DO_ACCESS_KEY_ID=your-do-access-key-id
DO_SECRET_ACCESS_KEY=your-do-secret-access-key
DO_SPACES_NAME=your-spaces-bucket-name
DO_REGION=your-region
DO_ENDPOINT_URL=https://your-region.digitaloceanspaces.com

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Alternative Email Providers
# For Office 365:
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587

# For SendGrid:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587

# Production Security Settings
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
