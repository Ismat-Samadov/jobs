# Environment Variables Template (.env)
EMAIL=your-email@example.com
PASSWORD=your_secure_password
SECRET_KEY=your-django-secret-key-here
DEBUG=False
APPENGINE_URL=your-app.uc.r.appspot.com
DATABASE_URL=postgres://username:password@host:port/database
GS_BUCKET_NAME=your-bucket-name
GCS_TYPE=service_account
GCS_PROJECT_ID=your-project-id
GCS_PRIVATE_KEY_ID=your-private-key-id
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
GCS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GCS_CLIENT_ID=your-client-id
GCS_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GCS_TOKEN_URI=https://oauth2.googleapis.com/token
GCS_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GCS_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-service-account@your-project.iam.gserviceaccount.com
ACCESS_TOKEN=your-access-token-here
OPENAI_API_KEY=sk-your-openai-api-key-here
DJANGO_SETTINGS_MODULE=your_project.settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@yourcompany.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@yourapp.com

# ============================================================================
# Google Cloud Secret Manager Setup Script
# ============================================================================

#!/bin/bash

# Create each secret and add its value as a version

# Email
gcloud secrets create EMAIL --replication-policy="automatic"
echo -n "your-email@example.com" | gcloud secrets versions add EMAIL --data-file=-

# Password
gcloud secrets create PASSWORD --replication-policy="automatic"
echo -n "your_secure_password" | gcloud secrets versions add PASSWORD --data-file=-

# Secret Key
gcloud secrets create SECRET_KEY --replication-policy="automatic"
echo -n "your-django-secret-key-here" | gcloud secrets versions add SECRET_KEY --data-file=-

# Debug
gcloud secrets create DEBUG --replication-policy="automatic"
echo -n "False" | gcloud secrets versions add DEBUG --data-file=-

# App Engine URL
gcloud secrets create APPENGINE_URL --replication-policy="automatic"
echo -n "your-app.uc.r.appspot.com" | gcloud secrets versions add APPENGINE_URL --data-file=-

# Database URL
gcloud secrets create DATABASE_URL --replication-policy="automatic"
echo -n "postgres://username:password@host:port/database" | gcloud secrets versions add DATABASE_URL --data-file=-

# GS Bucket Name
gcloud secrets create GS_BUCKET_NAME --replication-policy="automatic"
echo -n "your-bucket-name" | gcloud secrets versions add GS_BUCKET_NAME --data-file=-

# GCS Type
gcloud secrets create GCS_TYPE --replication-policy="automatic"
echo -n "service_account" | gcloud secrets versions add GCS_TYPE --data-file=-

# GCS Project ID
gcloud secrets create GCS_PROJECT_ID --replication-policy="automatic"
echo -n "your-project-id" | gcloud secrets versions add GCS_PROJECT_ID --data-file=-

# GCS Private Key ID
gcloud secrets create GCS_PRIVATE_KEY_ID --replication-policy="automatic"
echo -n "your-private-key-id" | gcloud secrets versions add GCS_PRIVATE_KEY_ID --data-file=-

# GCS Private Key
gcloud secrets create GCS_PRIVATE_KEY --replication-policy="automatic"
echo -n "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----" | gcloud secrets versions add GCS_PRIVATE_KEY --data-file=-

# GCS Client Email
gcloud secrets create GCS_CLIENT_EMAIL --replication-policy="automatic"
echo -n "your-service-account@your-project.iam.gserviceaccount.com" | gcloud secrets versions add GCS_CLIENT_EMAIL --data-file=-

# GCS Client ID
gcloud secrets create GCS_CLIENT_ID --replication-policy="automatic"
echo -n "your-client-id" | gcloud secrets versions add GCS_CLIENT_ID --data-file=-

# GCS Auth URI
gcloud secrets create GCS_AUTH_URI --replication-policy="automatic"
echo -n "https://accounts.google.com/o/oauth2/auth" | gcloud secrets versions add GCS_AUTH_URI --data-file=-

# GCS Token URI
gcloud secrets create GCS_TOKEN_URI --replication-policy="automatic"
echo -n "https://oauth2.googleapis.com/token" | gcloud secrets versions add GCS_TOKEN_URI --data-file=-

# GCS Auth Provider Cert URL
gcloud secrets create GCS_AUTH_PROVIDER_CERT_URL --replication-policy="automatic"
echo -n "https://www.googleapis.com/oauth2/v1/certs" | gcloud secrets versions add GCS_AUTH_PROVIDER_CERT_URL --data-file=-

# GCS Client Cert URL
gcloud secrets create GCS_CLIENT_CERT_URL --replication-policy="automatic"
echo -n "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account@your-project.iam.gserviceaccount.com" | gcloud secrets versions add GCS_CLIENT_CERT_URL --data-file=-

# Access Token
gcloud secrets create ACCESS_TOKEN --replication-policy="automatic"
echo -n "your-access-token-here" | gcloud secrets versions add ACCESS_TOKEN --data-file=-

# OpenAI API Key
gcloud secrets create OPENAI_API_KEY --replication-policy="automatic"
echo -n "sk-your-openai-api-key-here" | gcloud secrets versions add OPENAI_API_KEY --data-file=-

# Django Settings Module
gcloud secrets create DJANGO_SETTINGS_MODULE --replication-policy="automatic"
echo -n "your_project.settings" | gcloud secrets versions add DJANGO_SETTINGS_MODULE --data-file=-

# Email Backend
gcloud secrets create EMAIL_BACKEND --replication-policy="automatic"
echo -n "django.core.mail.backends.smtp.EmailBackend" | gcloud secrets versions add EMAIL_BACKEND --data-file=-

# Email Host
gcloud secrets create EMAIL_HOST --replication-policy="automatic"
echo -n "smtp.office365.com" | gcloud secrets versions add EMAIL_HOST --data-file=-

# Email Port
gcloud secrets create EMAIL_PORT --replication-policy="automatic"
echo -n "587" | gcloud secrets versions add EMAIL_PORT --data-file=-

# Email Use TLS
gcloud secrets create EMAIL_USE_TLS --replication-policy="automatic"
echo -n "True" | gcloud secrets versions add EMAIL_USE_TLS --data-file=-

# Email Use SSL
gcloud secrets create EMAIL_USE_SSL --replication-policy="automatic"
echo -n "False" | gcloud secrets versions add EMAIL_USE_SSL --data-file=-

# Email Host User
gcloud secrets create EMAIL_HOST_USER --replication-policy="automatic"
echo -n "your-email@yourcompany.com" | gcloud secrets versions add EMAIL_HOST_USER --data-file=-

# Email Host Password
gcloud secrets create EMAIL_HOST_PASSWORD --replication-policy="automatic"
echo -n "your-email-password" | gcloud secrets versions add EMAIL_HOST_PASSWORD --data-file=-

# Default From Email
gcloud secrets create DEFAULT_FROM_EMAIL --replication-policy="automatic"
echo -n "noreply@yourapp.com" | gcloud secrets versions add DEFAULT_FROM_EMAIL --data-file=-

echo "All secrets created successfully!"
